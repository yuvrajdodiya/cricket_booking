{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - Cricket Booking System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fa;
            color: #222;
        }

        .topbar {
            background: #0f172a;
            color: white;
            padding: 18px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
            color: #f59e0b;
        }

        .nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-size: 16px;
        }

        .hero {
            background: linear-gradient(rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.85)),
                        url("{% static 'images/cricket-banner.jpg' %}") center/cover no-repeat;
            height: 320px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
        }

        .hero h1 {
            font-size: 52px;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 18px;
            color: #f59e0b;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .about-section {
            max-width: 1200px;
            margin: 60px auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            gap: 40px;
            flex-wrap: wrap;
        }

        .about-image {
            flex: 1;
            min-width: 300px;
        }

        .about-image img {
            width: 100%;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .about-content {
            flex: 1;
            min-width: 300px;
        }

        .about-content h2 {
            font-size: 40px;
            color: #0f172a;
            margin-bottom: 20px;
        }

        .about-content p {
            font-size: 18px;
            line-height: 1.8;
            color: #555;
            margin-bottom: 16px;
        }

        .highlight {
            color: #f59e0b;
            font-weight: bold;
        }

        .features {
            max-width: 1200px;
            margin: 20px auto 70px;
            padding: 0 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .feature-box {
            background: white;
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

        .feature-box h3 {
            margin-bottom: 12px;
            color: #0f172a;
        }

        .feature-box p {
            color: #666;
            line-height: 1.6;
        }

        footer {
            background: #0f172a;
            color: white;
            text-align: center;
            padding: 18px;
        }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="logo">CricketBook</div>
        <div class="nav">
            <a href="{% url 'home' %}">Home</a>
            <a href="{% url 'about' %}">About</a>
            <a href="#">Grounds</a>
            <a href="#">Book Now</a>
            <a href="#">Login</a>
        </div>
    </div>

    <section class="hero">
        <p>We book cricket grounds</p>
        <h1>About Us</h1>
    </section>

    <section class="about-section">
        <div class="about-image">
            <img src="{% static 'images/cricket-about.jpg' %}" alt="Cricket">
        </div>
        <div class="about-content">
            <h2>Welcome to CricketBook</h2>
            <p>
                <span class="highlight">CricketBook</span> is a simple and easy-to-use cricket booking system.
                It helps users book cricket grounds online without any confusion.
            </p>
            <p>
                Our website is designed for cricket lovers who want to reserve a ground,
                check availability, and enjoy a smooth booking experience.
            </p>
            <p>
                We provide a fast, reliable, and user-friendly platform for cricket ground booking.
                Our goal is to make sports booking easy for everyone.
            </p>
        </div>
    </section>

    <section class="features">
        <div class="feature-box">
            <h3>Easy Booking</h3>
            <p>Book cricket grounds quickly in just a few clicks.</p>
        </div>
        <div class="feature-box">
            <h3>Best Experience</h3>
            <p>Simple design and smooth navigation for users.</p>
        </div>
        <div class="feature-box">
            <h3>Trusted Platform</h3>
            <p>Safe and reliable booking system for cricket lovers.</p>
        </div>
    </section>

    <footer>
        &copy; 2026 CricketBook. All rights reserved.
    </footer>

</body>
</html>